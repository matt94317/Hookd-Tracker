# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hookd:hookd@localhost:5432/hookd_tracker

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://localhost:5001

# ── Email (password reset) ────────────────────────────────────────────────────
# Gmail:   SMTP_HOST=smtp.gmail.com       SMTP_PORT=587
# Outlook: SMTP_HOST=smtp.office365.com   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── TikTok OAuth ──────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Instagram OAuth ───────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ── Token encryption ──────────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=

# ── Background job intervals (hours) ─────────────────────────────────────────
JOB_SYNC_POSTS_HOURS=1
JOB_REFRESH_TOKENS_HOURS=6
JOB_CHECK_TARGETS_HOURS=1
